{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "omniscient-ai",

  "framework": null,

  "builds": [
    {
      "src": "dashboard/landing.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard/_redirects",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api/health",
      "dest": "https://omniscient-ai-backend.onrender.com/api/health",
      "headers": { "x-from": "vercel-proxy" }
    },
    {
      "src": "/api/(.*)",
      "dest": "https://omniscient-ai-backend.onrender.com/api/$1",
      "headers": {
        "x-from": "vercel-proxy",
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/",
      "dest": "/dashboard/landing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard/landing.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" }
      ]
    },
    {
      "source": "/dashboard/landing.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/dashboard/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],

  "env": {
    "BACKEND_URL":          "https://omniscient-ai-backend.onrender.com",
    "NEXT_PUBLIC_API_BASE": "https://omniscient-ai-backend.onrender.com"
  },

  "regions": ["bom1"],

  "cleanUrls": true,
  "trailingSlash": false
}
