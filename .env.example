# ============================================================
# OMNISCIENT RESUME AI — Environment Configuration
# ============================================================
# 1. Copy:  cp .env.example .env
# 2. Fill values in .env (never commit .env)
# 3. For Docker Compose: see docs/DOCKER_ENV.md — add DB/pgAdmin/backend URI in .env only.

# ── Server ────────────────────────────────────────────────────
PORT=8000
PYTHONPATH=.

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── LLM — local Ollama ───────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Database (SQLite default) ─────────────────────────────────
DB_PATH=db/agent_memory.db

# ── Job Board APIs ────────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# ── Aggregator ────────────────────────────────────────────────
MAX_JOBS_PER_RUN=50

# ── Candidate Profile ─────────────────────────────────────────
CANDIDATE_NAME=John Doe
CANDIDATE_EMAIL=john@example.com
CANDIDATE_PHONE=+91-9999999999
CANDIDATE_LOCATION=Bangalore
CANDIDATE_GITHUB=https://github.com/johndoe
CANDIDATE_LINKEDIN=https://linkedin.com/in/johndoe

# ── Auto-Apply / Smart Apply ──────────────────────────────────
AUTO_APPLY_ENABLED=false
SMART_APPLY_MAX_AUTO_OPEN=2
SMART_APPLY_SELENIUM_AUTOFILL=true
RESUME_PATH=resume.pdf
APPLY_CONFIDENCE_THRESHOLD=85
REVIEW_CONFIDENCE_THRESHOLD=60

# ── Notifications: email / SendGrid / Twilio ─────────────────
# Implement SMTP and provider tokens only in private .env (not listed here).
EMAIL_ENABLED=false
SENDGRID_ENABLED=false
WHATSAPP_ENABLED=false

# ── Notification preferences ──────────────────────────────────
NOTIFY_MIN_SCORE=70
NOTIFY_MAX_PER_RUN=5
NOTIFY_QUIET_START=23
NOTIFY_QUIET_END=7
DASHBOARD_URL=http://localhost:8000
NOTIFY_NEW_JOB=true
NOTIFY_SUBMITTED=true
NOTIFY_CALLBACK=true
NOTIFY_REVIEW=true
NOTIFY_DAILY=true
NOTIFY_ANALYTICS=false

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ── Gunicorn (production) ─────────────────────────────────────
GUNICORN_WORKERS=2
